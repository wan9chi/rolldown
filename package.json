{
  "name": "monorepo",
  "private": true,
  "description": "Rollup in Rust",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "lint-knip": "knip",
    "lint-publint": "pnpm run -r --aggregate-output publint",
    "build": "echo \"Use just build\"",
    "build:release": "echo \"Use just build native release\"",
    "test": "echo \"Use just test-node\"",
    "ci:build-release-binding": "pnpm --filter rolldown run build-binding:release",
    "docs": "pnpm --filter rolldown-docs run dev",
    "docs:build": "vp run --filter rolldown-docs generate && vp run --filter rolldown-docs build",
    "docs:void": "vp run --filter rolldown-docs generate && pnpm --filter rolldown-docs run void deploy",
    "docs:preview": "pnpm --filter rolldown-docs run preview"
  },
  "devDependencies": {
    "@oxc-node/core": "catalog:",
    "@oxc-project/runtime": "catalog:",
    "@types/node": "catalog:",
    "cjs-module-lexer": "^2.1.0",
    "knip": "^6.13.1",
    "playwright-chromium": "^1.60.0",
    "publint": "^0.3.21",
    "remove-unused-vars": "^0.0.14",
    "rolldown": "workspace:*",
    "typescript": "catalog:",
    "vite-plus": "https://registry-bridge.viteplus.dev/tarballs/vite-plus/0.0.0-commit.a37c40a3a57a4ab175a9e02fd99b774982578c1e/8f7a1c477110ed63e0265b5e85a7a5ce9d14be16.tgz"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@11.4.0"
}
